  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\uC774\uB07C, mousse, moos, musgo, moss, mox. \uB2E4\uC591\uD55C \uBA85\uCE6D\uC73C\uB85C
    \uBD88\uB9AC\uB294 \uADF8\uAC83\uC740, \uC778\uAC04\uC758 \uC9C0\uC2DD\uC73C\uB860
    \uAC10\uD788 \uC774\uD574\uD574\uB0BC \uC218 \uC5C6\uB2E4. \n\n-\uCD94\uC2E0:
    2 x 3 -  7 + 5 + 2 \uBC88\uC9F8\uAC00 \uC601\uC5B4\uC774\uB2E4. \uB098\uBA38\uC9C4
    \uD504\uB791\uC2A4\uC5B4, \uB3C5\uC77C\uC5B4, \uC2A4\uD398\uC778\uC5B4, \uB7EC\uC2DC\uC544\uC5B4\uC774\uB2E4.\n<i>-
    \uC5B8\uC5B4\uD559\uC790 \uC774\uB07C \uC22D\uBC30\uC790 \uB9C8\uB974\uD06C -</i>\n\n\uC2E0\uC758
    \uC774\uB984\uC740 \uC2E0\uC778\uAC00? \uADF8\uB807\uC9C0 \uC54A\uB2E4. \uC6B0\uB9AC\uAC00
    \uADF8\uAC83\uC744 '\uC2E0'\uC774\uB77C\uACE0 \uBD80\uB97C \uBFD0, \uC2E0\uC758
    \uC774\uB984\uC740 \uC2E0\uB9CC\uC774 \uC548\uB2E4. \uC544\uB2C8, \uC5B4\uCA4C\uBA74
    \uC2E0\uC870\uCC28 \uBAA8\uB97C \uC218\uB3C4 \uC788\uB2E4. \uC911\uC694\uD55C\uAC74,
    \uC774\uB984\uC774\uB780\uAC74 \uACB0\uAD6D \uBB34\uC758\uBBF8\uD558\uB2E8 \uAC83\uC774\uB2E4.\n\n\uC774\uB07C\uB294
    \uC77C\uBC18\uC801\uC778 \uC0AC\uB78C\uB4E4\uC740 \uC54C\uC544\uCC44\uB9B4 \uC218\uC870\uCC28
    \uC5C6\uB294 \uC18D\uB3C4\uB85C \uC138\uC0C1\uC744 \uB9C8\uC74C\uB300\uB85C \uC8FC\uBB34\uB974\uB294
    \uC874\uC7AC\uB2E4. \uC778\uAC04\uC740 \uC774\uB07C\uC5D0 \uC800\uD56D\uD560
    \uC218 \uC5C6\uB2E4. \uD560 \uC218 \uC788\uB294\uAC74, \uC22D\uBC30 \uBFD0.\n\n<i>-
    1957\uB144 \uBB34\uBA85\uC758 \uC774\uB07C \uC22D\uBC30\uC790 \uBA54\uBAA8\uC5D0\uC11C
    \uBC1C\uCDCC - </i>"
  m_isRightToLeft: 0
