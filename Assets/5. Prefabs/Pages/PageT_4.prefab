  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n- \uC774\uB07C\uB294 \uD0C4\uC0DD\uD654\uB85C\uC11C \uC9C0\uC815\uB418\uAE30\uB3C4
    \uD558\uC600\uB2E4. \uB0A0\uC9DC\uB294 1\uC6D4 18\uC77C.\n<i><size=20>\"\uB9C8\uD06C,
    \uC774 \uBA4D\uCCAD\uC544! 18\uC77C\uC774 \uC544\uB2C8\uB77C\uACE0!\"</size></i>
    \n<i><size=20>\"\uC5D0\uC774\uB4E0. \uB0B4\uAC00 \uB108\uBCF4\uB2E4 \uC131\uC801
    \uC88B\uAC70\uB4E0? \uB0B4 \uB9D0\uC774 \uB9DE\uC744\uAC78.\"</size></i> \n<i><size=20>\"\uC5B4...\uADF8\uB7F0\uAC00?\"</size></i>\n<i><size=20>\"\uC5D0\uC774\uB4E0!
    \uC800 \uC790\uC2DD\uD55C\uD14C \uB610 \uC18D\uC544\uB118\uC5B4\uAC00\uBA74 \uC5B4\uB5A1\uD574!
    \uC57C, \uB9C8\uD06C! 7\uC6D4 25\uC77C\uC774\uB77C\uACE0. \uAE30\uC5B5\uD558\uB77C\uACE0!\"</size></i>\n<i><size=20>\"...\uC660\uC9C0
    7\uC6D4 25\uC77C\uC774 \uB9DE\uB294 \uAC83 \uAC19\uC740\uAC78.\"</size></i>\n<i><size=20>\"\uADF8\uB7EC\uAC8C,
    \uC5ED\uC2DC \uB8E8\uBE44\uB294 \uBBFF\uC744\uB9CC\uD574.\"</size></i>\n\n- \uC774\uB07C\uB294
    \uC228\uACA8\uC838\uC788\uB294 \uD798\uC758 \uAC15\uD568\uC5D0 \uB530\uB77C \uC5EC\uB7EC
    \uB4F1\uAE09\uC73C\uB85C \uB098\uB258\uC5B4\uC9C4\uB2E4.\n<i><size=20>\"\uC57C!
    \uB8E8\uBE44! \uB108\uAC00 \uB9D0\uD574\uC900\uAC70, \uD2C0\uB9B0\uAC70\uC600\uC796\uC544!\"</size></i>\n<i><size=20>\"\u314B\u314B
    \uADF8\uAC78 \uC9C4\uC9DC\uB85C \uBBFF\uC5C8\uC5B4?\"</size></i>\n<i><size=20>\"\uAE30\uB2E4\uB824\uBD10.
    \uB0B4\uAC00 \uAE08\uBC29 \uCC3E\uC544\uBCFC\uD14C\uB2C8\uAE4C... 10\uC6D4 12\uC77C\uC774\uB798.
    \uB9C8\uD06C.\"</size></i>"
  m_isRightToLeft: 0
