  m_Name: Iggi_2
  m_EditorClassIdentifier: 
  text: "- <b><size=40>\uADF8\uB0E5 \uC774\uB07C</b></size><i>normal iggiggi</i>\n\uC774
    \uB4F1\uAE09\uBD80\uD130 \uC774\uB07C\uB294 '\uACE0\uB4F1\uAE09'\uC73C\uB85C
    \uC778\uC815\uBC1B\uC73C\uBA70, \uC5C4\uC120\uB41C \uB18D\uC7A5\uACFC \uC560\uC815\uC744
    \uB4EC\uBFCD \uBC1B\uC544\uC57C\uB9CC 1\uC5B5\uBD84\uC758 1 \uD655\uB960\uB85C
    \uACB0\uC2E4\uC744 \uB9FA\uB294\uB2E4.\n\n- <b><size=40>\uCD5C\uC0C1\uAE09 \uC774\uB07C</b></size><i>god
    iggiggi</i>\n\uC774\uB984\uACFC\uB294 \uB2EC\uB9AC \uB9DB\uC5C6\uB2E4\uACE0 \uC545\uBA85\uC774
    \uB192\uC740 \uC774\uB07C\uC774\uB2E4. \uD488\uC9C8\uC740 \uCD5C\uACE0\uC774\uB2E4.\n\n-
    <b><size=40>\uACE0\uD488\uC9C8 \uC774\uB07C</b></size><i>gopumjil iggiggi</i>\n\uCD5C\uADFC
    \uBC1C\uACAC\uB41C \uC2E0\uC885\uC73C\uB85C, \uAE09\uD558\uAC8C \uC774 \uACF3\uC5D0
    \uAE30\uB85D\uD55C\uB2E4. \uADF8\uB0E5 \uC774\uB07C\uBCF4\uB2E4\uB294 \uD55C\uB2E8\uACC4
    \uB0AE\uC740 \uB4F1\uAE09\uC774\uB2E4."
